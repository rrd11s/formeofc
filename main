if M.AssemblyLinearVelocity.Magnitude>250 then M.AssemblyLinearVelocity=Vector3.new(0,0,0)end
if M.AssemblyAngularVelocity.Magnitude>250 then M.AssemblyAngularVelocity=Vector3.new(0,0,0)end
end
end
end)

