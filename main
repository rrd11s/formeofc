local function RegisterSearchItem(as,at,au,av)
local aw={
Text=string.lower(tostring(as)),
DisplayText=tostring(as),
Tab=at,
Frame=au,
Card=av
}
table.insert(ap,aw)
return aw
end

local function SetTab(as)
aq=as
for at,au in pairs(an)do
local av=at==as
au.Frame.Visible=av and ae.Text==""
local aw=ao[at]
if aw then
c:Create(aw.Btn,TweenInfo.new(0.16),{
BackgroundColor3=av and CurrentTheme.AccentSoft or CurrentTheme.Card2,
TextColor3=av and CurrentTheme.Text or CurrentTheme.Muted
}):Play()
c:Create(aw.Icon,TweenInfo.new(0.16),{
TextColor3=av and CurrentTheme.Text or CurrentTheme.Muted
}):Play()
end
end
end

local function ClearSearchResults()
if not ar then return end
for as,at in ipairs(ar:GetChildren())do
if at:IsA"GuiObject"then
at:Destroy()
end
end
end

local function RunSearch(as)
as=string.lower(as or"")
ClearSearchResults()

if as==""then
if ar then ar.Visible=false end
if aq and an[aq]then
an[aq].Frame.Visible=true
end
return
end

for at,au in pairs(an)do
au.Frame.Visible=false
end
if not ar then return end
ar.Visible=true

local at=0
for au,av in ipairs(ap)do
if string.find(av.Text,as,1,true)or string.find(string.lower(av.Tab),as,1,true)then
at+=1
local aw=Instance.new"TextButton"
aw.Size=UDim2.new(1,-4,0,42)
aw.BackgroundColor3=Color3.fromRGB(25,27,34)
aw.BorderSizePixel=0
aw.Text=""
aw.AutoButtonColor=false
aw.Parent=ar

local ax=Instance.new"UICorner"
ax.CornerRadius=UDim.new(0,8)
ax.Parent=aw

local ay=Instance.new"TextLabel"
ay.Size=UDim2.new(1,-18,0,19)
ay.Position=UDim2.new(0,10,0,5)
ay.BackgroundTransparency=1
ay.Text=av.DisplayText
ay.Font=Enum.Font.Arcade
ay.TextSize=11
ay.TextColor3=Color3.fromRGB(225,228,238)
ay.TextXAlignment=Enum.TextXAlignment.Left
ay.Parent=aw

local az=Instance.new"TextLabel"
az.Size=UDim2.new(1,-18,0,14)
az.Position=UDim2.new(0,10,0,24)
az.BackgroundTransparency=1
az.Text=av.Tab
az.Font=Enum.Font.Arcade
az.TextSize=9
az.TextColor3=Color3.fromRGB(110,115,132)
az.TextXAlignment=Enum.TextXAlignment.Left
az.Parent=aw

aw.MouseButton1Click:Connect(function()
ae.Text=""
SetTab(av.Tab)
task.defer(function()
if av.Frame and av.Frame.Parent then

end
end)
end)
end
end

if at==0 then
local au=Instance.new"TextLabel"
au.Size=UDim2.new(1,0,0,40)
au.BackgroundTransparency=1
au.Text="No settings found"
au.Font=Enum.Font.Arcade
au.TextSize=12
au.TextColor3=Color3.fromRGB(110,115,132)
au.Parent=ar
end
end

