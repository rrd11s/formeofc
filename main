local function GetPlayerColor(M)
local N=false
pcall(function()N=g:IsFriendsWith(M.UserId)end)
return N and _G.FriendColor or _G.EnemyColor
end

local function GetClosestTarget()
local M
local N=1000
local O=Vector2.new(h.X,h.Y)

for P,Q in ipairs(a:GetPlayers())do
if Q~=g and Q.Character and Q.Character:FindFirstChild"HumanoidRootPart"then local
R=GetPlayerHealth(Q)
if R>0 then
local S=false
pcall(function()S=g:IsFriendsWith(Q.UserId)end)
if not S or p then
local T=Q.Character.HumanoidRootPart
local U,V=i:WorldToViewportPoint(T.Position)
if V then
local W=(Vector2.new(U.X,U.Y)-O).Magnitude
if W<N then
N=W
M=Q
end
end
end
end
end
end
return M
end

local function UpdateTargetESP(M)
local N=J:FindFirstChild(M.Name.."_ESP")
if not N then return end

local O=N:FindFirstChild"Glow"
local P=N:FindFirstChild"NameTag"
local Q=P and P:FindFirstChildOfClass"TextLabel"

local R=k and l
local S=GetPlayerColor(M)

if O then
O.Enabled=R
O.FillColor=S
O.OutlineColor=S
O.FillTransparency=n and 0.85 or 0.5
O.OutlineTransparency=n and 1 or 0
end

if P then P.Enabled=R end

if Q and M.Character then local
T=GetPlayerHealth(M)
Q.TextColor3=S
Q.Font=B[C].Font
Q.Text=m and(M.DisplayName.." (@"..M.Name..") | "..T.." HP")or(M.DisplayName.." (@"..M.Name..")")
end
end

local function RefreshAllESP()
for M,N in ipairs(J:GetChildren())do
local O=string.sub(N.Name,1,#N.Name-4)
local P=a:FindFirstChild(O)
if P then UpdateTargetESP(P)end
end
end

local function LoadCharacter(M,N)
if M==g or not N then return end

local O=N:FindFirstChild"Head"
local P=N:FindFirstChildOfClass"Humanoid"
local Q=0
while(not O or not P)and Q<10 do
task.wait(0.3)
O=N:FindFirstChild"Head"
P=N:FindFirstChildOfClass"Humanoid"
Q=Q+0.3
end
if not O or not P then return end

local R=GetPlayerColor(M)

local S=J:FindFirstChild(M.Name.."_ESP")
if S then S:Destroy()end

local T=Instance.new"Folder"
T.Name=M.Name.."_ESP"
T.Parent=J

local U=Instance.new"Highlight"
U.Name="Glow"
U.Adornee=N
U.FillColor=R
U.OutlineColor=R
U.FillTransparency=n and 0.85 or 0.5
U.OutlineTransparency=n and 1 or 0
U.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
U.Enabled=k and l
U.Parent=T

local V=Instance.new"BillboardGui"
V.Name="NameTag"
V.Size=UDim2.new(0,160,0,35)
V.AlwaysOnTop=true
V.StudsOffset=Vector3.new(0,2.5,0)
V.Adornee=O
V.Enabled=k and l

local W=Instance.new"TextLabel"
W.BackgroundTransparency=1
W.Size=UDim2.new(1,0,1,0)
W.TextSize=12
W.Font=B[C].Font
W.TextColor3=R
W.TextStrokeTransparency=0.2
W.TextStrokeColor3=Color3.fromRGB(0,0,0)
W.Parent=V

V.Parent=T

UpdateTargetESP(M)

P.HealthChanged:Connect(function()
if m then UpdateTargetESP(M)end
end)
end

