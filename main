local shaderCard=CreateCard(as,"SHADERS","Visuals")
local Lighting=game:GetService("Lighting")
local function GetOrCreateEffect(className,name)
    local effect=Lighting:FindFirstChild(name)
    if not effect then effect=Instance.new(className); effect.Name=name; effect.Parent=Lighting end
    return effect
end
local bloom=GetOrCreateEffect("BloomEffect","AETE_Bloom")
bloom.Enabled=false
bloom.Intensity=0.65
bloom.Size=24
bloom.Threshold=0.8
local colorFx=GetOrCreateEffect("ColorCorrectionEffect","AETE_Color")
colorFx.Enabled=false
colorFx.Contrast=0.08
colorFx.Saturation=0.05
local rays=GetOrCreateEffect("SunRaysEffect","AETE_SunRays")
rays.Enabled=false
rays.Intensity=0.08
rays.Spread=0.75
local blurFx=GetOrCreateEffect("BlurEffect","AETE_Blur")
blurFx.Enabled=false
blurFx.Size=2
CreateToggle(shaderCard,"Bloom",false,function(v) bloom.Enabled=v end,"Visuals",shaderCard)
CreateToggle(shaderCard,"Color Correction",false,function(v) colorFx.Enabled=v end,"Visuals",shaderCard)
CreateToggle(shaderCard,"Sun Rays",false,function(v) rays.Enabled=v end,"Visuals",shaderCard)
CreateToggle(shaderCard,"Soft Blur",false,function(v) blurFx.Enabled=v end,"Visuals",shaderCard)


local fontCard=CreateCard(at,"Text Style","Visuals")
CreateButton(fontCard,"ESP Font",B[C].Name,function(btn)
    C=(C%#B)+1
    btn.Text=B[C].Name
    RefreshAllESP()
end,"Visuals",fontCard)
CreateButton(fontCard,"Menu Font",B[MenuFontIndex].Name,function(btn)
    MenuFontIndex=(MenuFontIndex%#B)+1
    MenuFont=B[MenuFontIndex].Font
    btn.Text=B[MenuFontIndex].Name
    ApplyTheme(CurrentTheme)
end,"Visuals",fontCard)

ApplyTheme=function(theme)
    CurrentTheme=theme or ThemeList[1]
    pcall(function()
        Y.BackgroundColor3=CurrentTheme.Panel
        menuBackground.Image=MENU_BACKGROUND_ASSET
        menuIcon.Image=MENU_ICON_ASSET
        cornerIcon.Image=CORNER_ICON_ASSET
        aestheticGradient.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,CurrentTheme.Panel),
            ColorSequenceKeypoint.new(0.48,CurrentTheme.Card),
            ColorSequenceKeypoint.new(1,CurrentTheme.Panel)
        })
        _.Color=CurrentTheme.Accent
        headerAccent.BackgroundColor3=CurrentTheme.Accent
        ab.BackgroundColor3=CurrentTheme.Card2
        ai.BackgroundColor3=CurrentTheme.Panel
        af.TextColor3=CurrentTheme.Accent
        af2.TextColor3=CurrentTheme.Muted
        ad.TextColor3=CurrentTheme.Muted
        ae.TextColor3=CurrentTheme.Text
        ae.PlaceholderColor3=CurrentTheme.Muted
        ag.BackgroundColor3=CurrentTheme.Card2
        ag.TextColor3=CurrentTheme.Text

        for _,obj in ipairs(Y:GetDescendants()) do
            if obj:IsA("TextLabel") then
                if obj.Name=="Title" then
                    obj.TextColor3=CurrentTheme.Text
                elseif obj.Text=="No settings found" or obj.Text=="aesthetic control panel" then
                    obj.TextColor3=CurrentTheme.Muted
                else
                    obj.TextColor3=CurrentTheme.Text
                end
                obj.Font=MenuFont

            elseif obj:IsA("TextBox") then
                obj.TextColor3=CurrentTheme.Text
                obj.PlaceholderColor3=CurrentTheme.Muted
                obj.Font=MenuFont

            elseif obj:IsA("TextButton") then
                obj.Font=MenuFont

                if string.match(obj.Name,"Nav$") then
                    obj.BackgroundColor3=CurrentTheme.Card2

                elseif obj.Text=="ON" then
                    obj.BackgroundColor3=CurrentTheme.Accent

                elseif obj.Text=="OFF" then
                    obj.BackgroundColor3=CurrentTheme.Button

                elseif obj.Text=="START FLING" or obj.Text=="Selected" or obj.Text=="Set" then
                    obj.BackgroundColor3=CurrentTheme.Accent
                    obj.TextColor3=CurrentTheme.Text

                elseif obj.Text=="STOP FLING" then
                    obj.BackgroundColor3=CurrentTheme.RoseDanger
                    obj.TextColor3=CurrentTheme.Text

                elseif obj.Text=="Select" then
                    obj.BackgroundColor3=CurrentTheme.Button
                    obj.TextColor3=CurrentTheme.Text

                elseif obj.Parent and string.find(obj.Parent.Name,"Setting_") then
             
                    local knob=obj:FindFirstChildOfClass("Frame")
                    if knob then
                        obj.BackgroundColor3=(knob.Position.X.Scale > 0.5) and CurrentTheme.Accent or CurrentTheme.Button
                    else
                        obj.BackgroundColor3=CurrentTheme.Button
                    end
                    obj.TextColor3=CurrentTheme.Text
                elseif obj.Parent and obj.Parent.Name=="SearchResults" then
                    obj.BackgroundColor3=CurrentTheme.Card2
                    obj.TextColor3=CurrentTheme.Text
                end

            elseif obj:IsA("Frame") and string.sub(obj.Name,1,5)=="Card_" then
                obj.BackgroundColor3=CurrentTheme.Card

            elseif obj:IsA("ScrollingFrame") then
                obj.ScrollBarImageColor3=CurrentTheme.Accent

            elseif obj:IsA("UIStroke") then
                if obj.Parent==Y then
                    obj.Color=CurrentTheme.Accent
                end
            end
        end

        if aq then
            SetTab(aq)
        end
    end)
end

NextTheme=function()
    ThemeIndex=(ThemeIndex%#ThemeList)+1
    ApplyTheme(ThemeList[ThemeIndex])
    return ThemeList[ThemeIndex].Name
end

NextSky=function()
    SkyIndex=(SkyIndex%#SkyList)+1
    ApplySkyPreset(SkyList[SkyIndex])
    return SkyList[SkyIndex]
end

ApplyTheme(ThemeList[ThemeIndex])
ApplySkyPreset(SkyList[SkyIndex])
SetTab"Visuals"


b.InputBegan:Connect(function(ba,bb)
if ba.KeyCode==Enum.KeyCode.LeftControl or ba.KeyCode==Enum.KeyCode.RightControl then
Y.Visible=not Y.Visible
return
end
if bb then return end

if ba.KeyCode==autoClickKey then
w=not w
aU(w)
elseif ba.KeyCode==q then
if not k or not o then return end
if r then
r=nil
else
r=GetClosestTarget()
end
end
end)

b.InputBegan:Connect(function(ba,bb)
if bb then return end
if ba.KeyCode==P then
R=not R
a3.Text="Macro Status: "..(R and"ON"or"OFF")
a3.TextColor3=R
and Color3.fromRGB(80,220,120)
or Color3.fromRGB(150,155,175)
end
end)

task.spawn(function()
while true do
if R and k then
pcall(function()
f:SendKeyEvent(true,O,false,game)
task.wait(0.001)
f:SendKeyEvent(false,O,false,game)
end)
task.wait(math.max(0,Q)/1000)
else
task.wait(0.1)
end
end
end)

task.spawn(function()
while true do
task.wait(0.1)


local ba=(typeof(k)=="boolean")and k or true

pcall(function()
for bb,bc in ipairs(a:GetPlayers())do
if bc~=g and bc.Character then
local bd=bc.Character
local be=bd:FindFirstChild(V)
local bf=bd:FindFirstChildOfClass"Humanoid"

if be and bf and bf.Health>0 then

local bg=true
if W and g.Team and bc.Team then
if bc.Team==g.Team then
bg=false
end
end
if S and ba and bg then
be.Size=Vector3.new(T,T,T)
be.Transparency=U
be.CanCollide=false
else

if V=="HumanoidRootPart"then
be.Size=Vector3.new(2,2,1)
be.Transparency=1
elseif V=="Head"then
be.Size=Vector3.new(2,1,1)
be.Transparency=0
end
end
end
end
end
end)
end
end)
