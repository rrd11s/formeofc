local function ShowRoleNotification(player,role)
    local card=Instance.new("Frame")
    card.Size=UDim2.new(1,0,0,64)
    card.BackgroundColor3=CurrentTheme.Card
    card.BorderSizePixel=0
    card.ZIndex=51
    card.Parent=notificationHolder
    Instance.new("UICorner",card).CornerRadius=UDim.new(0,10)
    local stroke=Instance.new("UIStroke",card)
    stroke.Color=CurrentTheme.Accent
    stroke.Transparency=0.25
    local title=Instance.new("TextLabel")
    title.Size=UDim2.new(1,-20,0,22)
    title.Position=UDim2.new(0,10,0,7)
    title.BackgroundTransparency=1
    title.Text="MODS IN SERVER"
    title.Font=MenuFont
    title.TextSize=11
    title.TextColor3=CurrentTheme.Accent
    title.TextXAlignment=Enum.TextXAlignment.Left
    title.ZIndex=52
    title.Parent=card
    local body=Instance.new("TextLabel")
    body.Size=UDim2.new(1,-20,0,22)
    body.Position=UDim2.new(0,10,0,29)
    body.BackgroundTransparency=1
    body.Text=player.DisplayName.." joined - "..role
    body.Font=MenuFont
    body.TextSize=10
    body.TextColor3=CurrentTheme.Text
    body.TextXAlignment=Enum.TextXAlignment.Left
    body.ZIndex=52
    body.Parent=card
    task.delay(5,function() if card then card:Destroy() end end)
end

local function CheckRole(player)
    task.spawn(function()
        local ok,role=pcall(function() return player:GetRoleInGroup(MOD_GROUP_ID) end)
        if not ok or not role then return end
        local r=string.lower(role)
        if string.find(r,"developer",1,true) or string.find(r,"owner",1,true) or string.find(r,"mod",1,true) or string.find(r,"admin",1,true) then
            if player~=g then ShowRoleNotification(player,role) end
        end
    end)
end

for _,player in ipairs(a:GetPlayers()) do CheckRole(player) end
a.PlayerAdded:Connect(CheckRole)


