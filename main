-- Keep the menu alive without breaking its child ZIndex hierarchy.
local function ProtectDashboard()
    pcall(function()
        if X.Parent~=H then X.Parent=H end
        X.Enabled=true
        X.DisplayOrder=999999999
        X.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
        if K.Parent~=I then K.Parent=I end
        K.Enabled=true
        K.DisplayOrder=999999
        K.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    end)
end

X.AncestryChanged:Connect(function()
    task.defer(ProtectDashboard)
end)
K.AncestryChanged:Connect(function()
    task.defer(ProtectDashboard)
end)

task.spawn(function()
    while task.wait(1) do
        ProtectDashboard()
    end
end)

