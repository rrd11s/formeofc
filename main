local function GetPlayerHealth(K)
if not K or not K.Character then return 100,100 end
local L=K.Character
local M=L:FindFirstChildOfClass"Humanoid"

local N=L:GetAttribute"Health"or L:GetAttribute"HP"
local O=L:GetAttribute"MaxHealth"or L:GetAttribute"MaxHP"or 100
if N then return math.floor(N),math.floor(O)end

local P=L:FindFirstChild"Health"or L:FindFirstChild"HP"
local Q=L:FindFirstChild"MaxHealth"or L:FindFirstChild"MaxHP"
if P and(P:IsA"NumberValue"or P:IsA"IntValue")then
local R=(Q and(Q:IsA"NumberValue"or Q:IsA"IntValue"))and Q.Value or 100
return math.floor(P.Value),math.floor(R)
end

if M then return math.floor(M.Health),math.floor(M.MaxHealth)end
return 100,100
end

