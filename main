}):Play()
av(aE)
end)

RegisterSearchItem(at,aw,ay,ax)

return function(aF)
aE=aF
c:Create(aA,TweenInfo.new(0.16),{
BackgroundColor3=aE and Color3.fromRGB(73,91,245)or Color3.fromRGB(43,45,55)
}):Play()
c:Create(aC,TweenInfo.new(0.16),{
Position=aE and UDim2.new(1,-14,0.5,-5.5)or UDim2.new(0,3,0.5,-5.5)
}):Play()
end
end

