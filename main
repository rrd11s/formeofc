for M,N in ipairs(a:GetPlayers())do
if N~=g and N.Character then
for O,P in ipairs(N.Character:GetChildren())do
if P:IsA"BasePart"then P.CanCollide=false end
end
end
end
local M=g.Character:FindFirstChild"HumanoidRootPart"
