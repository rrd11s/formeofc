local M=25
local N=35
local Offset=35

task.spawn(function()
while true do
if k and w then
    local low=math.max(1,tonumber(M) or 25)
    local high=math.max(low,tonumber(N) or low)
    local intervalMs=low
    if x and tonumber(Offset) and Offset>0 then
        local delta=math.random(-math.floor(Offset),math.floor(Offset))
        low=math.max(1,low+delta)
        high=math.max(low,high+delta)
    end
    intervalMs=math.random(math.floor(low),math.floor(high))

    local clicked=pcall(function()
        if type(mouse1click)=="function" then
            mouse1click()
        elseif f and h then
            f:SendMouseButtonEvent(h.X,h.Y,0,true,game,1)
            task.wait()
            f:SendMouseButtonEvent(h.X,h.Y,0,false,game,1)
        else
            error("No supported mouse input method")
        end
    end)
    if not clicked then
        task.wait(0.1)
    else
        task.wait(intervalMs/1000)
    end
else
    task.wait(0.1)
end
end
end)

